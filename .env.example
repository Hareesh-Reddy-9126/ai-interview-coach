# =============================================================================
# AI Interview Lab — Environment Configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# =============================================================================

# --- Supabase (frontend, public) ---------------------------------------------
# From Supabase Dashboard > Project Settings > API
VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"

# --- Supabase Edge Functions (server-side only) ------------------------------
# Set these with `npx supabase secrets set KEY=value` — never expose to frontend.
# NVIDIA_API_KEY is the only AI secret required in production.
# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY / SUPABASE_ANON_KEY are injected
# automatically by the Supabase runtime and do not need to be set locally.
NVIDIA_API_KEY="nvapi-your-nvidia-api-key"

# --- AI configuration (optional overrides) -----------------------------------
# Primary reasoning model served by NVIDIA NIM (OpenAI-compatible API).
NVIDIA_MODEL="nvidia/nemotron-3.5-super-vl-120b-a12b"
# Fallback used automatically when the primary model is unavailable.
NVIDIA_FALLBACK_MODEL="nvidia/nemotron-3-ultra-550b-a55b"
# Base URL of the OpenAI-compatible NVIDIA NIM endpoint.
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"

# --- Frontend origin used for CORS (optional override) -----------------------
# Defaults to "*" for local development. Set to your production domain.
SITE_URL="http://localhost:8080"
